# ===========================================
# LRM Ops API Environment Variables
# ===========================================
# For local development, export these in your shell or IDE run configuration, or put them in
# src/main/resources/application-local.yml (gitignored) and set SPRING_PROFILES_ACTIVE=local.

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# BC Gov SSO (Keycloak, standard realm). Callers present tokens from this realm.
# KEYCLOAK_ISSUER_URI=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
KEYCLOAK_ISSUER_URI=
# Which clients may call which endpoints is set in Keycloak: each calling client is assigned the
# API's client scopes (see ApiScopes and the README's "Consuming the API").

# Comma-separated browser origins allowed to call the API directly (CORS). Backends calling server
# to server need none.
ALLOWED_ORIGINS=http://localhost:3000

# Oracle TFM (LRMOPS), as the read-only proxy user from scripts/db/. Required for startup.
# DATABASE_HOST=your-oracle-host
# DATABASE_PORT=1543
# DATABASE_SERVICE_NAME=your_service_name
# DATABASE_USER=PROXY_FSA_LRM_READ_WRITE_USER
# DATABASE_PASSWORD=your_password
# TRUSTSTORE_PATH=/absolute/path/to/jssecacerts
# KEYSTORE_SECRET=your_truststore_password

APP_LOG_LEVEL=INFO
